rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Profile Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Phone Uniqueness Collection
    match /used_phones/{phone} {
      allow read: if true;
      allow write: if request.auth != null && !exists(/databases/$(database)/documents/used_phones/$(phone));
    }

    // Likes Collection
    match /likes/{likeId} {
      allow read, write: if request.auth != null;
    }

    // Blocks Collection
    match /blocks/{blockId} {
      allow read, write: if request.auth != null;
    }

    // Matches & Messages
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Legacy / Alternative Chats Collection
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Deletion Requests
    match /deletion_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
