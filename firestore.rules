rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read on used_phones so signup can check uniqueness
    match /used_phones/{phone} {
      allow read, write: if true;
    }

    // Allow full read/write for all application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
