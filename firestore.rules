rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      // Anyone signed in can view other profiles (for Discovery)
      allow read: if isSignedIn();
      // Only the owner can update their own profile
      allow write: if isOwner(userId);
    }

    // --- Matches ---
    match /matches/{matchId} {
      // Only users who are part of the match can read/write
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.users;
      // Allow creation if the creator is one of the users in the match
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      
      // --- Nested Messages ---
      match /messages/{messageId} {
        // Inherit match-level security
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      }
    }

    // --- Likes ---
    match /likes/{likeId} {
      // Only the sender can create the like
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.from;
      // Only the sender or receiver can read the like (for Star Gazers)
      allow read: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      // Only the sender or receiver can delete the like
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // --- Blocks ---
    match /blocks/{blockId} {
      // Only the blocker can manage their blocks
      allow read, write: if isSignedIn() && request.auth.uid == request.resource.data.blocker;
    }
  }
}
